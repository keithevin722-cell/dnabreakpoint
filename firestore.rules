rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only Google-authenticated users may read or post in chat.
    // Moderate by deleting a message in the Firebase console.
    match /messages/{id} {
      allow read: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['name', 'body', 'createdAt', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 500
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/lastPost/$(request.auth.uid)).data.t == request.time;
      allow update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 500
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'body']);
      allow delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && resource.data.uid == request.auth.uid;
    }

    // Limit each Google account to one post every 5 seconds.
    match /lastPost/{uid} {
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t == request.time;
      allow update: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t == request.time
        && request.time > resource.data.t + duration.value(5, 's');
      allow read, delete: if false;
    }
  }
}
